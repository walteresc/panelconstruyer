# OpenFieldPro en producción — Construyer (VPS único con la web pública).
# Copiar a .env en el VPS (chmod 600). No subir a git.

NODE_ENV=production
TZ=America/Lima

# Dominios (sin esquema en los *_ADDRESS)
OFP_SITE_ADDRESS=app.construyer.com
PUBLIC_SITE_ADDRESS=construyer.com
PUBLIC_API_URL=https://app.construyer.com
NEXT_PUBLIC_API_URL=https://app.construyer.com
PUBLIC_WEB_URL=https://app.construyer.com
CORS_ORIGIN=https://app.construyer.com,https://construyer.com
CONSTRUYER_SITE_URL=https://construyer.com
TRUST_PROXY=true

# Secretos: generar con `openssl rand -hex 32`
POSTGRES_PASSWORD=
JWT_SECRET=

# Alta de la primera organización: poner true SOLO mientras se crea el dueño y volver a false.
OFP_ALLOW_PUBLIC_REGISTRATION=false
# No cargar datos de demostración en producción.
OFP_SEED_DEMO=false

# Organización que recibe las solicitudes de construyer.com (vacío = la primera creada).
OFP_PUBLIC_ORG_ID=

# AGPL-3.0 §13: URL pública del código fuente de ESTA versión (fork público).
NEXT_PUBLIC_SOURCE_URL=https://github.com/walteresc/panelconstruyer

# Correo saliente (buzón del hosting compartido o el que uses)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Construyer <no-responder@construyer.com>"

# Pagos (vacío = cobros manuales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OFP_SPONSOR_ENABLED=false

# Aviso por WhatsApp al dueño en cada solicitud de la web (sin teléfono/correo del cliente en el mensaje).
# LEAD_ALERT_WHATSAPP_TO = tu número con código de país, solo dígitos (ej. 51987654321).
# Proveedor "callmebot": gratuito, número personal; activar enviando el mensaje que indica callmebot.com y poner la apikey que te devuelve.
# Proveedor "cloudapi": WhatsApp Cloud API de Meta; si el aviso va fuera de la ventana de 24 h hace falta una plantilla aprobada (1 variable de cuerpo).
LEAD_ALERT_WHATSAPP_PROVIDER=
LEAD_ALERT_WHATSAPP_TO=
# true = el aviso de WhatsApp/ntfy incluye el teléfono del cliente (pasa por el proveedor). El correo nunca va en ese aviso.
LEAD_ALERT_INCLUDE_CONTACT=false
# Correo al dueño con TODOS los datos de la solicitud (usa el SMTP de arriba). Vacío = no se envía.
LEAD_ALERT_EMAIL_TO=
CALLMEBOT_APIKEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANG=es
# Alternativa/complemento: notificación push gratuita (app ntfy) → NTFY_URL=https://ntfy.sh/<tema-secreto>
