# OpenFieldPro en producción — Construyer (VPS único con la web pública).
# Copiar a .env en el VPS (chmod 600). No subir a git.

NODE_ENV=production
TZ=America/Lima

# Dominios (sin esquema en los *_ADDRESS)
OFP_SITE_ADDRESS=app.construyer.com
PUBLIC_SITE_ADDRESS=construyer.com
PUBLIC_API_URL=https://app.construyer.com
NEXT_PUBLIC_API_URL=https://app.construyer.com
PUBLIC_WEB_URL=https://app.construyer.com
CORS_ORIGIN=https://app.construyer.com,https://construyer.com
CONSTRUYER_SITE_URL=https://construyer.com
TRUST_PROXY=true

# Secretos: generar con `openssl rand -hex 32`
POSTGRES_PASSWORD=
JWT_SECRET=

# Alta de la primera organización: poner true SOLO mientras se crea el dueño y volver a false.
OFP_ALLOW_PUBLIC_REGISTRATION=false
# No cargar datos de demostración en producción.
OFP_SEED_DEMO=false

# Organización que recibe las solicitudes de construyer.com (vacío = la primera creada).
OFP_PUBLIC_ORG_ID=

# AGPL-3.0 §13: URL pública del código fuente de ESTA versión (fork público).
NEXT_PUBLIC_SOURCE_URL=https://github.com/walteresc/panelconstruyer

# Correo saliente (buzón del hosting compartido o el que uses)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Construyer <no-responder@construyer.com>"

# Pagos (vacío = cobros manuales)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

OFP_SPONSOR_ENABLED=false
