# Un solo Caddy para todo el VPS:
#   · {$OFP_SITE_ADDRESS}     → panel de operaciones (web + API del mismo origen)
#   · {$PUBLIC_SITE_ADDRESS}  → web pública de Construyer (contenedor `construyer-web`)
# La web pública vive en otro repositorio y se une a esta red de Docker (ver docs/DEPLOY-CONSTRUYER.md).

{$OFP_SITE_ADDRESS} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}

{$PUBLIC_SITE_ADDRESS:public.localhost} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy construyer-web:3000

	log {
		output stdout
		format json
	}
}

# www → dominio principal en un solo salto 301.
www.{$PUBLIC_SITE_ADDRESS:public.localhost} {
	redir https://{$PUBLIC_SITE_ADDRESS:public.localhost}{uri} permanent
}
